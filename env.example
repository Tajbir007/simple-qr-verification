MONGO_URI=mongodb+srv://<db_user>:<db_pass>@<cluster_url><collection_name>?retryWrites=true&w=majority&appName=<cluster_name>
PORT=3000
# Number of reverse proxies in front of the app. Leave empty for local development;
# required in production (see README "Deployment") so rate limiting sees real client IPs.
TRUST_PROXY=
# Set to "production" when deployed (Render does this automatically): turns on Secure cookies.
NODE_ENV=
